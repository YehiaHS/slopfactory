# Slop Factory - Required API Keys
# Copy to .env and fill in your values

# Reddit API (create at https://www.reddit.com/prefs/apps)
SLOP_REDDIT_CLIENT_ID=
SLOP_REDDIT_CLIENT_SECRET=

# Mistral AI (get at https://console.mistral.ai/)
SLOP_MISTRAL_API_KEY=

# Optional
SLOP_OUTPUT_DIR=./outputs
SLOP_MAX_CONCURRENT_JOBS=4
SLOP_DEFAULT_SUBREDDITS=AskReddit,stories,confession,nosleep,TrueOffMyChest
